# High & Low on GoDaddy (Apache). Uploaded next to index.html by upload.sh.

# Compress the page (about 7 MB of inline data) before sending it.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Same cache rules as the old vercel.json: always revalidate the page, cache the icon for a day.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "^favicon\.png$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Never serve upload leftovers.
<FilesMatch "\.tmp$">
  Require all denied
</FilesMatch>
